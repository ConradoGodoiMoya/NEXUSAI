# ─── Banco de dados (MySQL 8+ ou MariaDB 10.6+) ───────────────────────────────
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=casatemtudo
DATABASE_PASSWORD=troque-esta-senha
DATABASE_NAME=casatemtudo

# ─── Sessão administrativa ───────────────────────────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# ─── Site ────────────────────────────────────────────────────────────────────
# URL pública (usada em SEO, sitemap e Open Graph). Sem barra no final.
NEXT_PUBLIC_SITE_URL=https://www.casatentudo.com.br

# Diretório onde as imagens enviadas pelo painel são salvas (fora de /public).
UPLOAD_DIR=./uploads

# ─── Primeiro administrador (usado apenas por `npm run admin:create`) ────────
ADMIN_NAME=Administrador
ADMIN_EMAIL=
ADMIN_PASSWORD=
